    {
      "id": "devices-helpers",
      "file": "card.py",
      "marker": "TODOOCARD-DEVICES: 别名注册表辅助函数",
      "lines": [
        "_LOGGER = logging.getLogger(\"todoocard\")"
      ],
      "replacement": [
        "_LOGGER = logging.getLogger(\"todoocard\")",
        "",
        "# TODOOCARD-DEVICES: 别名注册表辅助函数（扩展 2.0.4 注入）",
        "def _todoocard_devices(cfg):",
        "    \"\"\"归一化登记表：始终返回 [{alias, mac, name, uuids}]，脏数据不会混进发送路径。\"\"\"",
        "    out = []",
        "    for item in (cfg.get(\"devices\") or []):",
        "        if not isinstance(item, dict):",
        "            continue",
        "        alias = str(item.get(\"alias\") or \"\").strip()",
        "        if not alias:",
        "            continue",
        "        uuids = []",
        "        for u in (item.get(\"uuids\") or []):",
        "            u = str(u or \"\").strip().upper()",
        "            if u and u not in uuids:",
        "                uuids.append(u)",
        "        out.append({",
        "            \"alias\": alias,",
        "            \"mac\": str(item.get(\"mac\") or \"\").strip().upper(),",
        "            \"name\": str(item.get(\"name\") or \"\").strip(),",
        "            \"uuids\": uuids,",
        "        })",
        "    return out",
        "",
        "",
        "def _todoocard_device_mac(cfg):",
        "    alias = str(cfg.get(\"device_alias\") or \"\").strip()",
        "    for item in _todoocard_devices(cfg):",
        "        if alias and item[\"alias\"] == alias:",
        "            return item[\"mac\"]",
        "    return \"\"",
        "",
        "",
        "def _todoocard_owner(devices, uuid):",
        "    \"\"\"某个 macOS UUID 属于哪个别名；未登记返回空串。\"\"\"",
        "    u = str(uuid or \"\").strip().upper()",
        "    for item in devices:",
        "        if u and u in item[\"uuids\"]:",
        "            return item[\"alias\"]",
        "    return \"\"",
        "",
        "",
        "def _todoocard_upsert(cfg, alias, mac, uuid, name=\"\"):",
        "    \"\"\"人工登记/更新一条：同 MAC 或同别名就合并，UUID 去重，不产生重复条目。\"\"\"",
        "    alias = str(alias or \"\").strip()",
        "    if not alias:",
        "        raise ValueError(\"别名不能为空\")",
        "    uuid = str(uuid or \"\").strip().upper()",
        "    mac = str(mac or \"\").strip().upper().replace(\"-\", \":\")",
        "    if len(mac) == 12 and \":\" not in mac:",
        "        mac = \":\".join(mac[i:i + 2] for i in range(0, 12, 2))",
        "    devices = _todoocard_devices(cfg)",
        "    entry = None",
        "    for item in devices:",
        "        if (mac and item[\"mac\"] == mac) or item[\"alias\"] == alias:",
        "            entry = item",
        "            break",
        "    if entry is None:",
        "        entry = {\"alias\": alias, \"mac\": mac, \"name\": str(name or \"\").strip(), \"uuids\": []}",
        "        devices.append(entry)",
        "    if mac:",
        "        entry[\"mac\"] = mac",
        "    if name:",
        "        entry[\"name\"] = str(name).strip()",
        "    if uuid and uuid not in entry[\"uuids\"]:",
        "        entry[\"uuids\"].append(uuid)",
        "    return devices, entry",
        "",
        "",
        "def _todoocard_apply_selection(svc, alias):",
        "    \"\"\"按别名切换当前卡片：把它登记过的 UUID 拼成 device_id，写回配置。",
        "",
        "    这样 send()/_scan_card()/pair 等上游代码完全不用改，2.0.3 的精确匹配",
        "    会自动只认这一组 UUID，绝不连到别的卡。",
        "    \"\"\"",
        "    alias = str(alias or \"\").strip()",
        "    entry = next((d for d in _todoocard_devices(svc.cfg) if d[\"alias\"] == alias), None)",
        "    if entry is None:",
        "        raise ValueError(\"没有登记别名：\" + alias)",
        "    if not entry[\"uuids\"]:",
        "        raise ValueError(\"别名「\" + alias + \"」还没登记任何 macOS UUID\")",
        "    mac = entry[\"mac\"]",
        "    svc.save_cfg({",
        "        \"device_alias\": alias,",
        "        \"device_id\": \",\".join(entry[\"uuids\"]),",
        "        \"device_name\": (alias + \" | \" + mac) if mac else alias,",
        "        \"devices\": _todoocard_devices(svc.cfg),",
        "    })",
        "    return entry",
        "",
        "def _todoocard_sync_path():",
        "    \"\"\"注册表同步文件：位于思源 workspace 的 data/ 下，随思源自带备份/同步带走。",
        "",
        "    核心目录刻意放在 data/ 外面（否则思源同步会覆盖核心程序），所以 card.json",
        "    不会被备份。这里单独把「别名 + MAC + UUID 列表」写一份到",
        "    data/plugins/plugin-todoocard/todoocard-devices.json。",
        "    可用环境变量 TODOOCARD_DEVICES_FILE 覆盖路径（自定义核心目录布局时用）。",
        "    \"\"\"",
        "    import os",
        "",
        "    override = os.environ.get(\"TODOOCARD_DEVICES_FILE\")",
        "    if override:",
        "        return Path(override).expanduser()",
        "    base = Path(__file__).resolve().parent          # .../todoocard-core/eink",
        "    data_dir = base.parent.parent / \"data\"          # <SiYuan>/data",
        "    if not data_dir.is_dir():",
        "        return None",
        "    return data_dir / \"plugins\" / \"plugin-todoocard\" / \"todoocard-devices.json\"",
        "",
        "",
        "def _todoocard_restore_devices(cfg):",
        "    \"\"\"思源备份带回来的注册表优先于本地 card.json（换机/恢复后用它还原）。\"\"\"",
        "    path = _todoocard_sync_path()",
        "    if path is None or not path.is_file():",
        "        return False",
        "    try:",
        "        data = json.loads(path.read_text(\"utf-8\")) or {}",
        "    except Exception as e:",
        "        _LOGGER.warning(\"多设备注册表同步文件读取失败: %s\", e)",
        "        return False",
        "    devices = _todoocard_devices(data)",
        "    if not devices:",
        "        return False",
        "    cfg[\"devices\"] = devices",
        "    alias = str(data.get(\"device_alias\") or \"\").strip()",
        "    cfg[\"device_alias\"] = alias",
        "    entry = next((d for d in devices if d[\"alias\"] == alias), None)",
        "    if entry and entry[\"uuids\"]:",
        "        cfg[\"device_id\"] = \",\".join(entry[\"uuids\"])",
        "        cfg[\"device_name\"] = (alias + \" | \" + entry[\"mac\"]) if entry[\"mac\"] else alias",
        "    return True",
        "",
        "",
        "def _todoocard_persist_devices(cfg):",
        "    \"\"\"每次配置落盘都同步写一份到思源工作区；写不了只告警，不影响本地功能。\"\"\"",
        "    path = _todoocard_sync_path()",
        "    if path is None:",
        "        return False",
        "    try:",
        "        path.parent.mkdir(parents=True, exist_ok=True)",
        "        payload = {",
        "            \"schema\": 1,",
        "            \"device_alias\": str(cfg.get(\"device_alias\") or \"\").strip(),",
        "            \"devices\": _todoocard_devices(cfg),",
        "            \"updated\": datetime.now().isoformat(timespec=\"seconds\"),",
        "        }",
        "        tmp = path.with_suffix(path.suffix + \".tmp\")",
        "        tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2), \"utf-8\")",
        "        tmp.replace(path)",
        "        return True",
        "    except Exception as e:",
        "        _LOGGER.warning(\"多设备注册表同步文件写入失败: %s\", e)",
        "        return False"
      ]
    },
    {
      "id": "devices-api-handlers",
      "file": "card.py",
      "marker": "TODOOCARD-DEVICES: 多设备 API 与登记页",
      "lines": [
        "    async def _config(request):"
