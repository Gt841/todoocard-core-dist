      "replacement": [
        "    async def _devices_page(request):",
        "        # TODOOCARD-DEVICES: 多设备 API 与登记页（扩展包分发到 web/devices.html）",
        "        page = Path(__file__).resolve().parent / \"web\" / \"devices.html\"",
        "        if not page.is_file():",
        "            return web.Response(text=\"缺少 web/devices.html：请在插件控制台点「强制重装」\", status=500)",
        "        return web.FileResponse(page, headers={\"Cache-Control\": \"no-store\"})",
        "",
        "    async def _devices_list(request):",
        "        svc = current()",
        "        sync = _todoocard_sync_path()",
        "        return web.json_response({",
        "            \"ok\": True,",
        "            \"devices\": _todoocard_devices(svc.cfg),",
        "            \"device_alias\": svc.cfg.get(\"device_alias\") or \"\",",
        "            \"device_id\": svc.cfg.get(\"device_id\") or \"\",",
        "            \"device_name\": svc.cfg.get(\"device_name\") or \"\",",
        "            \"sync_file\": str(sync) if sync else \"\",",
        "            \"sync_exists\": bool(sync and sync.is_file()),",
        "        })",
        "",
        "    async def _devices_scan(request):",
        "        \"\"\"结构化扫描：macOS 广播里没有 MAC，只能拿到本机的 peripheral UUID。\"\"\"",
        "        try:",
        "            from bleak import BleakScanner",
        "        except Exception as e:",
        "            return web.json_response({\"ok\": False, \"error\": \"bleak 不可用: \" + str(e)}, status=500)",
        "",
        "        async def _go():",
        "            devs = await BleakScanner.discover(timeout=8.0, return_adv=True)",
        "            out = []",
        "            for addr, (dev, adv) in devs.items():",
        "                name = dev.name or adv.local_name or \"\"",
        "                mfr = adv.manufacturer_data or {}",
        "                if 0x5053 not in mfr and \"todoo\" not in name.lower():",
        "                    continue",
        "                raw = bytes(mfr.get(0x5053) or b\"\")",
        "                out.append({\"addr\": str(addr), \"name\": name,",
        "                            \"rssi\": getattr(adv, \"rssi\", None),",
        "                            \"manufacturer\": raw.hex(\" \")})",
        "            return out",
        "",
        "        try:",
        "            found = await asyncio.wait_for(_go(), timeout=15.0)",
        "        except Exception as e:",
        "            return web.json_response(",
        "                {\"ok\": False, \"error\": \"蓝牙扫描失败: \" + type(e).__name__ + \": \" + str(e)},",
        "                status=500)",
        "        devices = _todoocard_devices(current().cfg)",
        "        for item in found:",
        "            item[\"owner\"] = _todoocard_owner(devices, item[\"addr\"])",
        "        return web.json_response({\"ok\": True, \"found\": found, \"devices\": devices})",
        "",
        "    async def _devices_body(request):",
        "        try:",
        "            return (await request.json()) or {}",
        "        except Exception:",
        "            return {}",
        "",
        "    async def _devices_register(request):",
        "        body = await _devices_body(request)",
        "        svc = current()",
        "        try:",
        "            devices, entry = _todoocard_upsert(",
        "                svc.cfg, body.get(\"alias\"), body.get(\"mac\"),",
        "                body.get(\"uuid\"), body.get(\"name\"))",
        "        except ValueError as e:",
        "            return web.json_response({\"ok\": False, \"error\": str(e)}, status=400)",
        "        svc.save_cfg({\"devices\": devices})",
        "        if body.get(\"select\"):",
        "            try:",
        "                _todoocard_apply_selection(svc, entry[\"alias\"])",
        "            except ValueError as e:",
        "                return web.json_response({\"ok\": False, \"error\": str(e)}, status=400)",
        "        return web.json_response({\"ok\": True, \"card\": svc.status(),",
        "                                  \"device\": entry, \"devices\": _todoocard_devices(svc.cfg)})",
        "",
        "    async def _devices_select(request):",
        "        body = await _devices_body(request)",
        "        svc = current()",
        "        try:",
        "            entry = _todoocard_apply_selection(svc, body.get(\"alias\"))",
        "        except ValueError as e:",
        "            return web.json_response({\"ok\": False, \"error\": str(e)}, status=400)",
        "        return web.json_response({\"ok\": True, \"card\": svc.status(), \"device\": entry})",
        "",
        "    async def _devices_adopt(request):",
        "        \"\"\"UUID 轮换后：把新出现的 UUID 归到某个别名，重新拼好 device_id。\"\"\"",
        "        body = await _devices_body(request)",
        "        uuid = str(body.get(\"uuid\") or \"\").strip().upper()",
        "        if not uuid:",
        "            return web.json_response({\"ok\": False, \"error\": \"缺少 uuid\"}, status=400)",
        "        svc = current()",
        "        try:",
        "            devices, entry = _todoocard_upsert(svc.cfg, body.get(\"alias\"), None, uuid)",
        "        except ValueError as e:",
        "            return web.json_response({\"ok\": False, \"error\": str(e)}, status=400)",
        "        svc.save_cfg({\"devices\": devices})",
        "        if (svc.cfg.get(\"device_alias\") or \"\") == entry[\"alias\"]:",
        "            _todoocard_apply_selection(svc, entry[\"alias\"])",
        "        return web.json_response({\"ok\": True, \"card\": svc.status(),",
        "                                  \"device\": entry, \"devices\": _todoocard_devices(svc.cfg)})",
        "",
        "    async def _devices_remove(request):",
        "        body = await _devices_body(request)",
        "        alias = str(body.get(\"alias\") or \"\").strip()",
        "        svc = current()",
        "        devices = [d for d in _todoocard_devices(svc.cfg) if d[\"alias\"] != alias]",
        "        patch = {\"devices\": devices}",
