        "            patch.update({\"device_alias\": \"\", \"device_id\": \"\", \"device_name\": \"\"})",
        "        svc.save_cfg(patch)",
        "        return web.json_response({\"ok\": True, \"card\": svc.status(), \"devices\": devices})",
        "",
        "    async def _devices_reload(request):",
        "        \"\"\"思源备份恢复/换机后，从同步文件重新载入注册表，不用重启核心。\"\"\"",
        "        svc = current()",
        "        path = _todoocard_sync_path()",
        "        if path is None or not path.is_file():",
